FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BRIDGE_CONFIG=/app/config/agents.cloud-shadow.yaml \
    COMMAND_CENTER_HOST=0.0.0.0 \
    COMMAND_CENTER_PORT=8080 \
    COMMAND_CENTER_DISABLE_WATCHERS=1 \
    COMMAND_CENTER_GOOGLE_AUTH_ENABLED=1 \
    NOVA_AGENT_RUNTIME_MODE=shadow

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY config/agents.cloud-shadow.yaml ./config/agents.cloud-shadow.yaml
COPY config/tool-fast-paths.json ./config/tool-fast-paths.json
COPY kanban-command-center ./kanban-command-center

RUN python -m pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin nova \
    && mkdir -p /app/data/command_center/jobs /tmp/nova-command-center \
    && chown -R nova:nova /app/data /tmp/nova-command-center

USER 10001:10001

EXPOSE 8080

CMD ["python", "-m", "codex_slack_bridge.command_center_server"]
