<Window x:Class="AgentChat.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentChat.Desktop"
        Title="Agent Chat"
        Height="920"
        Width="1420"
        MinHeight="720"
        MinWidth="1080"
        Background="#05070B"
        Foreground="#EDF4FF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050B12" Offset="0" />
            <GradientStop Color="#07111D" Offset="0.55" />
            <GradientStop Color="#050B12" Offset="1" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="GridOverlayBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,32,32"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#06FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,32,1" />
                                <RectangleGeometry Rect="0,0,1,32" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="Surface0" Color="#050B12" />
        <SolidColorBrush x:Key="Surface1" Color="#E609121F" />
        <SolidColorBrush x:Key="Surface2" Color="#F20D1B2E" />
        <SolidColorBrush x:Key="Surface3" Color="#152033" />
        <SolidColorBrush x:Key="LineBrush" Color="#3D4978A0" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#2616334E" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6F4FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA9BD" />
        <SolidColorBrush x:Key="DimBrush" Color="#566274" />
        <SolidColorBrush x:Key="AccentBrush" Color="#24F2B4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#22D3EE" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#F5B942" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF4D6D" />

        <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="24" ShadowDepth="10" Opacity="0.22" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#111B2A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#2A3B56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#17263B" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#3C5578" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#0D1522" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2CE6A0" />
            <Setter Property="Foreground" Value="#04110D" />
            <Setter Property="BorderBrush" Value="#2CE6A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#6AF0BD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#19B77B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B111C" />
            <Setter Property="Foreground" Value="#B9C6D8" />
            <Setter Property="BorderBrush" Value="#1E2B40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#111B2A" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#334762" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#0C1421" />
            <Setter Property="Foreground" Value="#9FACBD" />
            <Setter Property="BorderBrush" Value="#243650" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#4A658B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#04110D" />
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#09111D" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#263851" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#315F88" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableMessageTextStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemShell"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#102033" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#2B7BC0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell" Property="Background" Value="#0E1827" />
                                <Setter TargetName="ItemShell" Property="BorderBrush" Value="#233958" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AgentTemplate">
            <Grid Margin="4" MinHeight="66">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28"
                        Height="28"
                        CornerRadius="7"
                        Background="#102033"
                        BorderBrush="#2B7BC0"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Initials}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Grid Width="18"
                      Height="18"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,-2,12"
                      Effect="{Binding RunStateGlowEffect}">
                    <Ellipse Fill="{Binding RunStateHaloBrush}" />
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding RunStateBrush}"
                             Stroke="#080D15"
                             StrokeThickness="1.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Column="1" Margin="8,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding BadgeLabel}"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="8,2,0,0" />
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding WorkspaceRoot}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate">
            <Border Margin="18,9"
                    Padding="0"
                    MaxWidth="880"
                    Background="{Binding BubbleBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="{Binding Align}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding RoleBrush}" CornerRadius="7,0,0,7" />
                    <StackPanel Grid.Column="1" Margin="15,13,15,14">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding RoleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Header}" Foreground="#A9B6CA" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TimeLabel}"
                                       Foreground="#566274"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                 Style="{StaticResource SelectableMessageTextStyle}">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy"
                                              Command="ApplicationCommands.Copy"
                                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Copy Message"
                                              Click="CopyMessageMenuItem_Click"
                                              CommandParameter="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#08121F"
                                            BorderBrush="#2B3D57"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,8,8"
                                            MaxWidth="238">
                                        <StackPanel>
                                            <Border Background="#050A12"
                                                    BorderBrush="#162640"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Margin="0,0,0,7"
                                                    Visibility="{Binding ImageVisibility}">
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="210"
                                                       MaxHeight="138"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True" />
                                            </Border>
                                            <DockPanel LastChildFill="True">
                                                <Button Content="OPEN"
                                                        Width="52"
                                                        Height="26"
                                                        Padding="0"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        Tag="{Binding Path}"
                                                        Click="OpenAttachment_Click" />
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBlueBrush}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding FileName}" Foreground="#C7D4E7" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="292" MinWidth="200" MaxWidth="420" />
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition x:Name="RightColumn" Width="348" MinWidth="240" MaxWidth="520" />
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="3"
                   Fill="{StaticResource GridOverlayBrush}"
                   IsHitTestVisible="False"
                   Opacity="0.9"
                   Panel.ZIndex="-10" />

        <Border x:Name="LeftRail"
                Grid.Column="0"
                Background="#080D15"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#102033" BorderBrush="#2B7BC0" BorderThickness="1">
                                <TextBlock Text="AI" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="AGENT CHAT" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="LOCAL COMMAND CENTER" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="NEW SESSION"
                                Width="124"
                                Height="36"
                                DockPanel.Dock="Right"
                                ToolTip="Archive the current session and start fresh for this agent"
                                Click="NewConversation_Click" />
                    </DockPanel>

                    <TextBlock Text="AGENTS" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="18" Background="#0C1420" BorderBrush="#1E2B40" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock Text="{Binding MemoryStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>

                <ListBox ItemsSource="{Binding Agents}"
                         SelectedItem="{Binding SelectedAgent}"
                         ItemTemplate="{StaticResource AgentTemplate}"
                         SelectionChanged="AgentList_SelectionChanged" />
            </DockPanel>
        </Border>

        <GridSplitter x:Name="LeftSplitter"
                      Grid.Column="0"
                      Width="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      Panel.ZIndex="10" />
        <GridSplitter x:Name="RightSplitter"
                      Grid.Column="2"
                      Width="6"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      Panel.ZIndex="10" />

        <Grid x:Name="MainPanel" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition x:Name="DialogueRow" Height="*" />
                <RowDefinition x:Name="ComposerRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#070B12"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    MinHeight="60">
                <DockPanel Margin="22,8">
                    <StackPanel x:Name="FullHeaderTitlePanel" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedConversation.Title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Effect="{Binding RunStateGlowEffect}">
                                <Ellipse Fill="{Binding RunStateHaloBrush}" />
                                <Ellipse Width="8" Height="8" Fill="{Binding RunStateBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedAgent.DisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text=" / " Foreground="{StaticResource DimBrush}" FontSize="12" />
                            <TextBlock Text="{Binding RunState}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CompactHeaderPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="AGENT" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ListBox ItemsSource="{Binding Agents}"
                                 SelectedItem="{Binding SelectedAgent}"
                                 SelectionChanged="AgentList_SelectionChanged"
                                 MinWidth="200"
                                 MaxWidth="520"
                                 Height="42">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,7">
                                        <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Effect="{Binding RunStateGlowEffect}">
                                            <Ellipse Fill="{Binding RunStateHaloBrush}" />
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding RunStateBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="480">
                        <Button Content="{Binding CompactButtonLabel}" Width="82" Margin="0,2,8,2" Style="{StaticResource QuietButtonStyle}" Click="ToggleCompact_Click" ToolTip="Toggle compact always-on-top mode" />
                        <ToggleButton x:Name="DeepToggle" Content="DEEP" IsChecked="{Binding UseSubagents}" Width="58" Margin="0,2,8,2" ToolTip="Allow configured subagents" />
                        <ToggleButton x:Name="WebToggle" Content="WEB" IsChecked="{Binding UseWeb}" Width="54" Margin="0,2,8,2" ToolTip="Allow public web when needed" />
                        <ToggleButton x:Name="GuiToggle" Content="GUI" IsChecked="{Binding UseGui}" Width="52" Margin="0,2,10,2" ToolTip="Allow browser and Windows UI tools" />
                        <Button x:Name="ArchiveButton" Content="ARCHIVE" Width="82" Margin="0,2,8,2" Style="{StaticResource QuietButtonStyle}" Click="ArchiveSession_Click" ToolTip="Archive and clear this agent session" />
                        <Button Content="STOP" Width="72" Margin="0,2,0,2" Style="{StaticResource QuietButtonStyle}" Click="Stop_Click" ToolTip="Stop the current run" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="MessagesScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          Padding="4,12,4,12">
                <ItemsControl ItemsSource="{Binding ActiveMessages}" ItemTemplate="{StaticResource MessageTemplate}" />
            </ScrollViewer>

            <Border x:Name="ComposerShell"
                    Grid.Row="2"
                    Background="#070B12"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="PendingAttachmentsPanel" ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F1725"
                                        BorderBrush="#2B3D57"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,6"
                                        Margin="0,0,8,8">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBlueBrush}" FontSize="10" FontWeight="Bold" Margin="0,2,7,0" />
                                            <TextBlock Text="{Binding FileName}" Foreground="#C7D4E7" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="7,2,0,0" />
                                        </StackPanel>
                                        <Button Content="x" Width="24" Height="24" Margin="8,0,0,0" Padding="0" DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveAttachment_Click" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="+"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Style="{StaticResource QuietButtonStyle}"
                                ToolTip="Attach files"
                                Click="Attach_Click" />
                        <Button Grid.Column="1"
                                Content="{Binding MicButtonLabel}"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Background="{Binding MicButtonBrush}"
                                BorderBrush="{Binding MicButtonBrush}"
                                IsEnabled="{Binding SpeechInputAvailable}"
                                ToolTip="Dictate into the composer"
                                Click="ToggleMic_Click" />
                        <TextBox x:Name="ComposerBox"
                                 Grid.Column="2"
                                 MinHeight="42"
                                 MaxHeight="150"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="ComposerBox_KeyDown" />
                        <Button Grid.Column="3"
                                Content="SEND"
                                Width="82"
                                Height="42"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Send_Click" />
                    </Grid>

                    <DockPanel x:Name="VoiceControlPanel" Grid.Row="2" Margin="2,10,2,0" LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding VoiceBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VoiceDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ToggleButton Content="TALK"
                                          IsChecked="{Binding ConversationMode}"
                                          IsEnabled="{Binding SpeechInputAvailable}"
                                          Width="62"
                                          Margin="0,0,8,0"
                                          ToolTip="Hands-free conversation: speak, pause to send, hear the reply, mic re-opens" />
                            <ToggleButton Content="SPEAK REPLIES"
                                          IsChecked="{Binding SpeakReplies}"
                                          IsEnabled="{Binding SpeechOutputAvailable}"
                                          Width="122"
                                          Margin="0,0,8,0"
                                          ToolTip="Read completed replies aloud"
                                          Click="SpeakReplies_Click" />
                            <Button Content="QUIET"
                                    Width="62"
                                    Style="{StaticResource QuietButtonStyle}"
                                    ToolTip="Stop speech output"
                                    Click="StopVoice_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="RightRail"
                Grid.Column="2"
                Background="#080D15"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Surface1}"
                        BorderBrush="{Binding PixelAgentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6"
                        Margin="0,0,0,12"
                        Effect="{Binding PixelAgentGlowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,7,0" Effect="{Binding PixelAgentGlowEffect}">
                                    <Ellipse Fill="{Binding PixelAgentGlowBrush}" />
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{Binding WorkingSpriteBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="AGENT OFFICE" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PixelAgentStateLabel}"
                                       DockPanel.Dock="Right"
                                       Foreground="{Binding WorkingSpriteBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </DockPanel>
                        <!-- AgentChat/coding_agent 2026-07-08: animated pixel office; every agent has a desk. -->
                        <Border Grid.Row="1"
                                Background="#07111D"
                                BorderBrush="#3D4978A0"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Margin="0,4,0,6">
                            <local:PixelOfficeControl x:Name="OfficeView" Height="128" />
                        </Border>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding WorkingAgentDetail}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxHeight="34"
                                       Margin="0,0,0,6" />
                            <ProgressBar Height="4"
                                         IsIndeterminate="{Binding AnyAgentRunning}"
                                         Visibility="{Binding WorkingProgressVisibility}"
                                         Foreground="{Binding WorkingSpriteBrush}"
                                         Background="#132338" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="CONTEXT DEPTH / AGENT" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ContextMessages}" DockPanel.Dock="Right" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold" />
                    </DockPanel>
                    <Slider Minimum="4" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding ContextMessages}" Margin="0,10,0,0" ToolTip="Saved separately for each selected agent." />
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="LIVE LOG" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <ToggleButton Content="{Binding LogToggleLabel}"
                                  IsChecked="{Binding IsLogOpen}"
                                  Width="82"
                                  DockPanel.Dock="Right" />
                </DockPanel>

                <Border Grid.Row="3"
                        Background="#050A12"
                        BorderBrush="#182640"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{Binding LogVisibility}"
                        MaxHeight="420"
                        Margin="0,0,0,16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="PROCESS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding RunState}" DockPanel.Dock="Right" Foreground="{Binding RunStateBrush}" FontSize="11" FontWeight="Bold" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding RunLog}" Foreground="#A9B6CA" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="OPEN DATA" Style="{StaticResource QuietButtonStyle}" Click="OpenData_Click" />
                    <Button Grid.Column="2" Content="OPEN ROOT" Style="{StaticResource QuietButtonStyle}" Click="OpenRoot_Click" />
                </Grid>
            </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Grid.ColumnSpan="2"
                Panel.ZIndex="50"
                Visibility="{Binding ToastVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,88,24,0"
                Background="#111B2A"
                BorderBrush="#2CE6A0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
