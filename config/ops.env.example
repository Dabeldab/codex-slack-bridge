# Bridge environment variables (optional — defaults shown below).
# Load this file into your .env before running codex_slack_bridge.app.

SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
GITHUB_TOKEN=ghp-your-token

# ChatGPT Work reasoning relay. Production uses the explicit chatgpt_work_relay
# provider; this toggle is retained only for compatibility/testing of older configs.
REASONING_RELAY_ENABLED=false
REASONING_RELAY_REPOSITORY=dariusmakesstuff/codex-slack-bridge
REASONING_RELAY_BRANCH=reasoning-relay-bus
REASONING_RELAY_POLL_SECONDS=2
REASONING_RELAY_RESPONSE_TIMEOUT_SECONDS=900
REASONING_RELAY_JOB_TIMEOUT_SECONDS=3600
REASONING_RELAY_MAX_ROUNDS=20
REASONING_RELAY_KEEP_MESSAGES=false

# Reuse the existing repository-scoped GitHub App credential files. Values are
# paths only; never commit the credential contents.
GITHUB_APP_ID_PATH=
GITHUB_APP_INSTALLATION_ID_PATH=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_ALLOWED_REPOSITORIES=dariusmakesstuff/codex-slack-bridge

# Azure DevOps relay shim (optional). Azure auth uses Microsoft Entra/OIDC;
# do not put PATs or client secrets here.
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_RELAY_WORK_ITEM_ID=

# Known repos (comments only — use with gh --repo OWNER/NAME)
# dariusmakesstuff/logmein-connector   auto-tickets connector + Cloud Run CI
# dariusmakesstuff/codex-slack-bridge  this repo
