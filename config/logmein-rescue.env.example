# Agent Chat-owned LogMeIn Rescue config.
# Copy to config/logmein-rescue.env (gitignored). Agent Chat loads this into
# spawned tickets_agent Codex processes after config/ops.env and .env, so these
# values override generic app env files. OS environment variables still win.
#
# Do not commit real credentials, authcodes, API keys, webhook secrets, or
# customer-specific secrets.

# Optional convenience value for agents/scripts. The existing connector repo is
# still the implementation source; this file supplies runtime config.
LOGMEIN_CONNECTOR_ROOT=C:/Users/redma/Workworkworkworkworkwork/auto-tickets/logmein-connector

# Optional base URL for protected connector HTTP routes when using Cloud Run or
# a local server. Examples:
# LOGMEIN_CONNECTOR_BASE_URL=https://your-connector.example.com
# LOGMEIN_CONNECTOR_BASE_URL=http://127.0.0.1:8000
LOGMEIN_CONNECTOR_BASE_URL=

# Protected connector routes: /api/rescue/create-session, /api/rescue/calling-card,
# /api/rescue/handoff, /fetch, /status. Send this as X-API-Key or Bearer.
API_KEY=
INTERNAL_API_KEY=

# LogMeIn Rescue API auth. Token/authcode is preferred when valid; password auth
# can request a fresh authcode when RESCUE_PIN_USE_PASSWORD=1 or token is absent.
RESCUE_BASE=https://secure.logmeinrescue.com/API
RESCUE_SOAP_API_URL=
RESCUE_USER=
RESCUE_PASS=
RESCUE_EMAIL=
RESCUE_PWD=
RESCUE_API_TOKEN=
RESCUE_VERIFY_SSL=1

# Node/channel settings. PIN creation uses RESCUE_PIN_NODE_ID, then RESCUE_NODE_ID,
# then RESCUE_GROUP_NODE_ID. Reporting uses RESCUE_NODE_ID or RESCUE_GROUP_NODE_ID.
RESCUE_GROUP_NODE_ID=
RESCUE_NODE_ID=
RESCUE_NODE_REF=CHANNEL
RESCUE_REPORT_NODETYPE=CHANNEL
RESCUE_PIN_NODE_ID=
RESCUE_PIN_USE_PASSWORD=0
RESCUE_PIN_SOAP_VERSION=3
RESCUE_PIN_V4_NO_WEB_TC=0
RESCUE_CUSTOMER_PIN_URL=https://secure.logmeinrescue.com/Customer/Code.aspx

# Region/dedicated-host override only when LogMeIn support tells you to use one.
RESCUE_SOAP_ACTION_REQUEST_PIN_V2=
RESCUE_SOAP_ACTION_REQUEST_PIN_V3=
RESCUE_SOAP_ACTION_REQUEST_PIN_V4=

# C-field mapping used for PIN creation, webhooks, account matching, and survey contact hints.
CUSTOMER_NAME_CFIELD=0
CUSTOMER_PHONE_CFIELD=1
CUSTOMER_COMPANY_CFIELD=2
CUSTOMER_LOCATION_CFIELD=
CUSTOMER_EMAIL_CFIELD=

# Calling Card and Nova Live Support handoff.
RESCUE_CALLING_CARD_CHANNEL_NAME=
RESCUE_CALLING_CARD_COMPANY_ID=
RESCUE_CALLING_CARD_DOWNLOAD_BASE=https://secure.logmeinrescue.com/Customer/Download.aspx
REMOTE_SUPPORT_ENABLED=0
REMOTE_SUPPORT_HANDOFF_MODE=pin
REMOTE_SUPPORT_PUBLIC_BASE_URL=
REMOTE_SUPPORT_LAUNCH_URL=novapos-livesupport://start
REMOTE_SUPPORT_DOWNLOAD_URL=https://pos.novapointofsale.com/supportLatest.msi

# Webhook security for local/replay/testing scenarios. Production should usually
# set these through Secret Manager or the host environment.
LOGMEIN_WEBHOOK_ENABLED=0
LOGMEIN_WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=

# Reporter/poller defaults for local read-only checks and dry runs.
USE_CHATLOG_REPORT=1
REPORT_TODAY_ONLY=0
POLL_INTERVAL_SECONDS=60
POLL_STATE_BACKEND=auto

# Safer ticket automation defaults when Salesforce ticket creation is enabled by
# explicit user request and the Salesforce env is also configured.
SKIP_TICKET_IF_NO_ACCOUNT_MATCH=1
